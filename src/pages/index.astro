---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Backdrop from "../components/Backdrop.astro";
import Hero from "../sections/Hero.astro";
import Proof from "../sections/Proof.astro";
import Fit from "../sections/Fit.astro";
import Method from "../sections/Method.astro";
import Results from "../sections/Results.astro";
import Formats from "../sections/Formats.astro";
import Pricing from "../sections/Pricing.astro";
import Coach from "../sections/Coach.astro";
import Athlete from "../sections/Athlete.astro";
import Credentials from "../sections/Credentials.astro";
import Faq from "../sections/Faq.astro";
import Contact from "../sections/Contact.astro";
import SiteFooter from "../sections/SiteFooter.astro";
import { hero } from "../content";
---

<Base>
  <SiteHeader />
  <Backdrop />

  <main id="main">
    <Hero />
    <Proof />
    <Fit />
    <Method />
    <div class="window-band" aria-hidden="true"></div>
    <Results />
    <div class="window-band" aria-hidden="true"></div>
    <Formats />
    <Pricing />
    <Coach />
    <div class="window-band" aria-hidden="true"></div>
    <Athlete />
    <div class="window-band" aria-hidden="true"></div>
    <Credentials />
    <div class="window-band" aria-hidden="true"></div>
    <Faq />
    <div class="window-band" aria-hidden="true"></div>
    <Contact />
  </main>

  <SiteFooter />

  <!-- Mobile only. Appears once the hero CTA has left the viewport and hides
       again near #contact so it never covers the real form. -->
  <div class="sticky-cta" data-sticky hidden>
    <a class="btn btn-primary sticky-btn" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
  </div>
</Base>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-sticky);
    padding: 0.6rem var(--gut) calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--glass);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line-soft);
    transform: translateY(100%);
    transition: transform var(--t-base) var(--ease);
  }
  .sticky-cta.is-in { transform: none; }
  /* Gold, as before — just dialled down: roughly 12% smaller than the standard
     button and the fill mixed 8% toward the page ground so it reads as an
     action rather than a banner. The hero CTA it duplicates is never on screen
     at the same time, so the two golds never sit side by side. */
  .sticky-btn {
    width: 100%;
    /* padding + line-height were overriding min-height and landing at 49px;
       zero block padding lets the flex centring hold the box at exactly 42 */
    min-height: 42px;
    padding-block: 0;
    padding-inline: 1.5rem;
    font-size: 0.9375rem;
    background: color-mix(in oklab, var(--gold) 92%, var(--deep));
  }
  .sticky-btn:hover {
    background: color-mix(in oklab, var(--gold-deep) 94%, var(--deep));
  }
  .sticky-cta[hidden] { display: none; }

  @media (min-width: 769px) { .sticky-cta { display: none !important; } }
</style>

<script>
  import { composeHandoffMessage, validate } from "../lib/contact";
  import { contact } from "../content";

  /* ------------------------------------------------------------------ *
   * Three small islands. No framework runtime, no bundled library.
   * Every one of them is progressive: with this file absent the page
   * still renders completely and every link still works.
   * ------------------------------------------------------------------ */

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* --- header: scroll state, overlay, focus trap --------------------- */
  (() => {
    const hdr = document.querySelector<HTMLElement>("[data-hdr]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-hdr-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-hdr-panel]");
    if (!hdr) return;

    // The hero opens clean; the bar only gains its ground after it.
    const onScroll = () => {
      hdr.classList.toggle("is-solid", window.scrollY > window.innerHeight * 0.6);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      hdr.classList.toggle("is-open", open);
      document.body.style.overflow = open ? "hidden" : "";
      if (open) panel.querySelector<HTMLElement>("a")?.focus();
      else toggle.focus();
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );

    // Following a link should close the overlay, not leave it covering the
    // section the user just asked for.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) setOpen(false);
      if (e.key !== "Tab" || panel.hidden) return;
      const items = [toggle, ...panel.querySelectorAll<HTMLElement>("a, button")];
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    // A resize past the breakpoint must not leave the overlay stranded open.
    window.matchMedia("(min-width: 1101px)").addEventListener("change", (m) => {
      if (m.matches && !panel.hidden) setOpen(false);
    });
  })();

  /* --- reveal --------------------------------------------------------- *
   * If IntersectionObserver is unavailable, everything reveals immediately.
   * A reveal may enhance; it may never be the reason content is invisible.
   * ------------------------------------------------------------------- */
  (() => {
    const items = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
    const showAll = () => items.forEach((el) => el.classList.add("is-in"));

    if (reduced.matches || !("IntersectionObserver" in window)) {
      showAll();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-in");
          io.unobserve(e.target); // once, never again on the way back up
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -5% 0px" },
    );
    items.forEach((el) => io.observe(el));
  })();

  /* --- backdrop: scroll-driven canvas frame animation --------------- *
   * Canvas-based WebP image sequence: 72 frames of the canoe stroke.
   * Frame-by-frame scrubbing directly bound to scroll progress.
   * Guaranteed 60fps/120fps hardware-accelerated rendering on ALL mobile devices
   * (iOS Safari, Android Chrome) with zero seek latency.
   * ------------------------------------------------------------------ */
  (() => {
    const backdrop = document.querySelector<HTMLElement>("[data-backdrop]");
    const mediaContainer = backdrop?.querySelector<HTMLElement>("[data-backdrop-media]");
    const canvas = mediaContainer?.querySelector<HTMLCanvasElement>(".backdrop-canvas");
    const poster = mediaContainer?.querySelector<HTMLElement>(".backdrop-poster");
    if (!backdrop || !mediaContainer || !canvas) return;

    if (reduced.matches || (navigator as unknown as { connection?: { saveData?: boolean } }).connection?.saveData === true) {
      return;
    }

    const ctx = canvas.getContext("2d", { alpha: false });
    if (!ctx) return;

    const TOTAL_FRAMES = 72;
    const PX_PER_CYCLE = 450; // 450px scroll = 1 full canoe stroke cycle
    const frames: HTMLImageElement[] = [];
    let loadedCount = 0;
    let currentFrame = -1;
    let targetFrame = 0;
    let smoothFrame = 0;
    let rafId = 0;

    // Preload all 72 frames
    for (let i = 1; i <= TOTAL_FRAMES; i++) {
      const img = new Image();
      const pad = String(i).padStart(3, "0");
      img.src = `/media/frames/frame_${pad}.webp`;
      img.onload = () => {
        loadedCount++;
        if (loadedCount === 1 && currentFrame === -1) {
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          currentFrame = 0;
          if (poster) poster.style.display = "none";
        }
      };
      frames.push(img);
    }

    // Parallax mouse depth on desktop
    window.addEventListener("mousemove", (e) => {
      if (window.innerWidth < 768) return;
      const x = (e.clientX / window.innerWidth - 0.5) * 14;
      const y = (e.clientY / window.innerHeight - 0.5) * 8;
      canvas.style.transform = `translate3d(${-x}px, ${-y}px, 0)`;
    }, { passive: true });

    function tick() {
      if (!document.hidden && loadedCount > 0) {
        const scrollY = window.pageYOffset || window.scrollY || document.documentElement.scrollTop || 0;
        // Continuous cycle index
        const rawIndex = (scrollY / PX_PER_CYCLE) * TOTAL_FRAMES;
        targetFrame = ((rawIndex % TOTAL_FRAMES) + TOTAL_FRAMES) % TOTAL_FRAMES;

        // Smooth shortest-path interpolation across loop seam
        let diff = targetFrame - smoothFrame;
        if (diff > TOTAL_FRAMES / 2) diff -= TOTAL_FRAMES;
        if (diff < -TOTAL_FRAMES / 2) diff += TOTAL_FRAMES;

        if (Math.abs(diff) > 0.04) {
          smoothFrame = ((smoothFrame + diff * 0.35) + TOTAL_FRAMES) % TOTAL_FRAMES;
          const frameIdx = Math.floor(smoothFrame) % TOTAL_FRAMES;

          if (frameIdx !== currentFrame) {
            const img = frames[frameIdx];
            if (img && img.complete && img.naturalWidth > 0) {
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              currentFrame = frameIdx;
              if (poster && poster.style.display !== "none") {
                poster.style.display = "none";
              }
            }
          }
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    rafId = requestAnimationFrame(tick);
  })();

  /* --- video ---------------------------------------------------------- *
   * src lives in data-src and is only promoted when motion is allowed AND
   * the element is actually visible at this breakpoint. So a phone never
   * downloads the desktop loop, and someone who asked for reduced motion
   * downloads nothing at all — they keep the poster.
   * ------------------------------------------------------------------- */
  (() => {
    const vids = document.querySelectorAll<HTMLVideoElement>("[data-autovideo]");
    if (reduced.matches) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (!v.poster && v.dataset.poster) v.poster = v.dataset.poster;
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            if (!v.dataset.paused) v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.1 },
    );

    vids.forEach((v) => {
      // Coordinated groups are owned by their own island below.
      if (v.dataset.videoGroup) return;
      // offsetParent is null when a display:none breakpoint hides it
      if (v.offsetParent === null) return;
      io.observe(v);

      const wrap = v.closest(".av");

      // Sound toggle — only on the one video whose audio is content.
      // It still autoplays muted; browsers permit nothing else, and the
      // click that unmutes is the user gesture that makes it legal.
      const snd = wrap?.querySelector<HTMLButtonElement>("[data-av-sound]");
      if (snd) {
        const sLabel = snd.querySelector<HTMLElement>("[data-av-label]")!;
        const sIcon = snd.querySelector<HTMLElement>("[data-av-ic]")!;
        snd.hidden = false;
        snd.addEventListener("click", () => {
          v.muted = !v.muted;
          snd.setAttribute("aria-pressed", String(!v.muted));
          sLabel.textContent = v.muted ? "Звук" : "Без звуку";
          sIcon.textContent = v.muted ? "♪" : "✕";
          // unmuting is also an invitation to actually watch it
          if (!v.muted) v.play().catch(() => {});
        });
        return;
      }

      const btn = wrap?.querySelector<HTMLButtonElement>("[data-av-pause]");
      const label = btn?.querySelector<HTMLElement>("[data-av-label]");
      if (!btn || !label) return;
      btn.hidden = false;
      btn.addEventListener("click", () => {
        if (v.paused) { delete v.dataset.paused; v.play().catch(() => {}); label.textContent = "Пауза"; }
        else { v.pause(); v.dataset.paused = "1"; label.textContent = "Грати"; }
      });
    });
  })();

  /* --- water videos -------------------------------------------------- *
   * Three clips, one playback focus. Roles swap on the grid (active vs
   * two previews) without recreating the video nodes, so decode state and
   * the single audio stream stay coherent.
   * ------------------------------------------------------------------- */
  (() => {
    const stage = document.querySelector<HTMLElement>("[data-water-stage]");
    if (!stage) return;

    const items = [...stage.querySelectorAll<HTMLElement>("[data-water-item]")];
    const videos = items.map((item) => item.querySelector<HTMLVideoElement>("[data-autovideo]"));
    const roles = ["active", "preview-a", "preview-b"] as const;

    const paintSound = (v: HTMLVideoElement | null) => {
      if (!v) return;
      const snd = v.closest(".av")?.querySelector<HTMLButtonElement>("[data-av-sound]");
      if (!snd) return;
      snd.setAttribute("aria-pressed", String(!v.muted));
      const sLabel = snd.querySelector<HTMLElement>("[data-av-label]");
      const sIcon = snd.querySelector<HTMLElement>("[data-av-ic]");
      if (sLabel) sLabel.textContent = v.muted ? "Звук" : "Без звуку";
      if (sIcon) sIcon.textContent = v.muted ? "♪" : "✕";
    };

    const paintPause = (v: HTMLVideoElement | null) => {
      if (!v) return;
      const btn = v.closest(".av")?.querySelector<HTMLButtonElement>("[data-av-pause]");
      const label = btn?.querySelector<HTMLElement>("[data-av-label]");
      if (!btn || !label) return;
      label.textContent = v.paused && v.dataset.paused ? "Грати" : "Пауза";
    };

    const paintChrome = (index: number) => {
      items.forEach((item, i) => {
        const on = i === index;
        const v = videos[i];
        const snd = item.querySelector<HTMLButtonElement>("[data-av-sound]");
        const pause = item.querySelector<HTMLButtonElement>("[data-av-pause]");
        const select = item.querySelector<HTMLButtonElement>("[data-water-select]");
        if (snd) snd.hidden = !on;
        if (pause) pause.hidden = !on;
        if (select) {
          select.hidden = on;
          select.tabIndex = on ? -1 : 0;
        }
        if (v) {
          v.tabIndex = -1;
          paintSound(v);
          paintPause(v);
        }
      });
    };

    const loadPoster = (v: HTMLVideoElement) => {
      if (!v.poster && v.dataset.poster) v.poster = v.dataset.poster;
    };

    const assignRoles = (index: number) => {
      const order = [index, ...items.map((_, i) => i).filter((i) => i !== index)];
      order.forEach((itemIndex, rank) => {
        const item = items[itemIndex];
        const on = rank === 0;
        item.classList.toggle("is-active", on);
        item.dataset.waterRole = roles[rank];
      });
    };

    if (reduced.matches) {
      videos.forEach((v) => { if (v) loadPoster(v); });
      paintChrome(items.findIndex((item) => item.classList.contains("is-active")) || 0);
      items.forEach((item, i) => {
        item.querySelector("[data-water-select]")?.addEventListener("click", () => {
          assignRoles(i);
          paintChrome(i);
        });
      });
      return;
    }

    let active = items.findIndex((item) => item.classList.contains("is-active"));
    if (active < 0) active = 0;
    let inView = false;

    const pauseAt = (i: number) => {
      const v = videos[i];
      if (!v) return;
      v.pause();
      v.muted = true;
      delete v.dataset.waterActive;
      paintSound(v);
      paintPause(v);
    };

    const playAt = (i: number, unmute = false, force = false) => {
      const v = videos[i];
      if (!v) return;
      loadPoster(v);
      v.dataset.waterActive = "1";
      v.muted = !unmute;
      if (force) delete v.dataset.paused;
      const shouldPlay = (force || inView) && !v.dataset.paused;
      if (!v.src && v.dataset.src) v.src = v.dataset.src;
      if (shouldPlay) v.play().catch(() => {});
      paintSound(v);
      paintPause(v);
    };

    const applyActive = (index: number, unmute = false, force = false) => {
      assignRoles(index);
      items.forEach((_, i) => {
        if (i === index) playAt(i, unmute, force);
        else pauseAt(i);
      });
      paintChrome(index);
      active = index;
    };

    const setActive = (index: number, unmute = false, force = false) => {
      const swap = () => applyActive(index, unmute, force);
      const canView =
        !reduced.matches &&
        index !== active &&
        typeof document.startViewTransition === "function";
      if (canView) {
        document.startViewTransition(swap);
        return;
      }
      swap();
    };

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        if (inView) {
          videos.forEach((v) => { if (v) loadPoster(v); });
          applyActive(active);
        } else videos.forEach((_, i) => pauseAt(i));
      },
      { threshold: 0, rootMargin: "0px 0px -12% 0px" },
    ).observe(stage);

    paintChrome(active);

    stage.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const item = t.closest<HTMLElement>("[data-water-item]");
      if (!item || !stage.contains(item)) return;
      const i = items.indexOf(item);
      if (i < 0) return;

      if (t.closest("[data-av-sound]")) {
        e.preventDefault();
        e.stopPropagation();
        const v = videos[i];
        const nextUnmute = i === active ? !!v?.muted : true;
        applyActive(i, nextUnmute, true);
        return;
      }

      if (t.closest("[data-av-pause]")) {
        e.preventDefault();
        e.stopPropagation();
        const v = videos[i];
        if (!v || i !== active) return;
        if (v.paused) {
          delete v.dataset.paused;
          v.play().catch(() => {});
        } else {
          v.pause();
          v.dataset.paused = "1";
        }
        paintPause(v);
        return;
      }

      if (i === active) return;
      setActive(i, false, true);
    });
  })();

  /* --- before / after -------------------------------------------------- *
   * The handle sweeps on its own so the comparison reads without anyone
   * touching it, and stays fully operable by pointer, keyboard and click.
   *
   * Motion is a sine between 12% and 88% — never 0 or 100, because letting
   * either side vanish completely makes it read as a glitch rather than a
   * comparison.
   *
   * The detail that is easy to lose in a refactor is syncPhase(). When the
   * user lets go, the wave is restarted FROM the position they left it at
   * instead of from where it would have been on its own. Without that, every
   * release snaps the handle sideways.
   * ------------------------------------------------------------------- */
  (() => {
    const root = document.querySelector<HTMLElement>("[data-ba]");
    if (!root) return;
    const stage = root.querySelector<HTMLElement>("[data-ba-stage]");
    const handle = root.querySelector<HTMLElement>("[data-ba-handle]");
    if (!stage || !handle) return;

    const MIN = 12, MAX = 88;
    const MID = (MIN + MAX) / 2;
    const AMP = (MAX - MIN) / 2;
    const OMEGA = 1.15;           // rad/s — a full sweep every ~5.5s

    const clamp = (n: number) => Math.min(MAX, Math.max(MIN, n));
    let pos = MID;
    let phase = 0;
    let t0 = performance.now();
    let dragging = false;
    let focused = false;
    let onScreen = false;

    // aria is only updated while the user is actually driving. Firing it on
    // every animation frame would make a screen reader chatter at a control
    // nobody is touching.
    const paintAria = () => {
      const v = Math.round(pos);
      handle.setAttribute("aria-valuenow", String(v));
      handle.setAttribute("aria-valuetext", `${v}% — частка кадру «до»`);
    };
    const paint = (withAria: boolean) => {
      stage.style.setProperty("--pos", pos.toFixed(2) + "%");
      if (withAria) paintAria();
    };

    /** Restart the wave from wherever the handle currently sits. */
    const syncPhase = () => {
      const t = (performance.now() - t0) / 1000;
      const ratio = Math.min(1, Math.max(-1, (pos - MID) / AMP));
      const ang = Math.asin(ratio);
      const goingRight = Math.cos(t * OMEGA + phase) >= 0;
      phase = (goingRight ? ang : Math.PI - ang) - t * OMEGA;
    };

    const held = () => dragging || focused;

    let raf = 0;
    const tick = (now: number) => {
      if (!held()) {
        pos = MID + Math.sin(((now - t0) / 1000) * OMEGA + phase) * AMP;
        paint(false);
      }
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (!raf) { syncPhase(); raf = requestAnimationFrame(tick); } };
    const stopLoop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };

    const fromClientX = (x: number) => {
      const r = stage.getBoundingClientRect();
      pos = clamp(((x - r.left) / r.width) * 100);
      paint(true);
    };

    handle.addEventListener("pointerdown", (e) => {
      dragging = true;
      handle.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    handle.addEventListener("pointermove", (e) => { if (dragging) fromClientX(e.clientX); });
    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try { handle.releasePointerCapture(e.pointerId); } catch {}
      syncPhase();           // resume from here, not from a jump
    };
    handle.addEventListener("pointerup", release);
    handle.addEventListener("pointercancel", release);

    // clicking anywhere on the frame jumps the handle there
    stage.addEventListener("pointerdown", (e) => {
      if (e.target === handle || handle.contains(e.target as Node)) return;
      fromClientX(e.clientX);
      syncPhase();
    });

    // While the handle has focus the keyboard owns it — the sweep would
    // otherwise fight every arrow press.
    handle.addEventListener("focus", () => { focused = true; paintAria(); });
    handle.addEventListener("blur", () => { focused = false; syncPhase(); });

    handle.addEventListener("keydown", (e) => {
      const step = e.shiftKey ? 10 : 1;
      let next = pos;
      if (e.key === "ArrowLeft" || e.key === "ArrowDown") next = pos - step;
      else if (e.key === "ArrowRight" || e.key === "ArrowUp") next = pos + step;
      else if (e.key === "Home") next = MIN;
      else if (e.key === "End") next = MAX;
      else return;
      e.preventDefault();
      pos = clamp(next);
      paint(true);
    });

    handle.setAttribute("aria-valuemin", String(MIN));
    handle.setAttribute("aria-valuemax", String(MAX));
    paint(true);

    /* --- case switcher ------------------------------------------------ *
     * Each thumbnail swaps the pair the slider is comparing. The frame's
     * aspect follows the case, because the archive shots run to 0.40 while
     * the studio pair is 0.75 and one fixed ratio would letterbox most of
     * them.
     * ----------------------------------------------------------------- */
    const raw = root.querySelector<HTMLElement>("[data-ba-cases]")?.textContent;
    const cases = raw ? JSON.parse(raw) : [];
    const imgBefore = root.querySelector<HTMLImageElement>("[data-ba-before]");
    const imgAfter = root.querySelector<HTMLImageElement>("[data-ba-after]");
    const elTitle = root.querySelector<HTMLElement>("[data-ba-title]");
    const elSub = root.querySelector<HTMLElement>("[data-ba-sub]");
    const elCount = root.querySelector<HTMLElement>("[data-ba-count]");
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-ba-thumb]")];

    const show = (i: number) => {
      const c = cases[i];
      if (!c || !imgBefore || !imgAfter) return;

      imgBefore.src = c.before;
      imgBefore.alt = `До — ${c.alt}`;
      imgAfter.src = c.after;
      imgAfter.alt = `Після — ${c.alt}`;
      imgBefore.width = imgAfter.width = c.w;
      imgBefore.height = imgAfter.height = c.h;

      stage.style.setProperty("--ratio", String(c.ratio));
      if (c.bakedLabels) stage.dataset.baked = "true";
      else delete stage.dataset.baked;

      if (elTitle) elTitle.textContent = c.title;
      if (elSub) elSub.textContent = c.sub;
      if (elCount) {
        elCount.textContent =
          `${String(i + 1).padStart(2, "0")} / ${String(cases.length).padStart(2, "0")}`;
      }

      thumbs.forEach((t, n) => {
        t.classList.toggle("is-on", n === i);
        t.setAttribute("aria-selected", n === i ? "true" : "false");
      });

      // restart the sweep from the middle on every switch, so a new case
      // always opens in a readable state
      pos = MID;
      paint(true);
      syncPhase();
    };

    thumbs.forEach((t, i) => {
      t.addEventListener("click", () => show(i));
      // a tablist should also answer to arrow keys
      t.addEventListener("keydown", (e) => {
        let n = i;
        if (e.key === "ArrowRight") n = (i + 1) % thumbs.length;
        else if (e.key === "ArrowLeft") n = (i - 1 + thumbs.length) % thumbs.length;
        else return;
        e.preventDefault();
        thumbs[n].focus();
        show(n);
      });
    });

    if (reduced.matches) return;   // static at midpoint, still draggable

    // Do not animate a control nobody is looking at.
    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen) { t0 = performance.now(); start(); } else stopLoop();
      },
      { threshold: 0.2 },
    ).observe(stage);
  })();

  /* --- sticky mobile CTA ----------------------------------------------- *
   * It must never cover the contact form or the footer credit. Observing
   * #contact alone was not enough: that section is taller than the viewport,
   * so once it had scrolled past, isIntersecting went false again and the bar
   * reappeared over the footer. The scroll position is the reliable signal,
   * with the observers as a fast path.
   * -------------------------------------------------------------------- */
  (() => {
    const bar = document.querySelector<HTMLElement>("[data-sticky]");
    const heroCta = document.querySelector<HTMLElement>(".hero-actions");
    const contactSec = document.getElementById("contact");
    if (!bar || !heroCta || !contactSec) return;
    if (!window.matchMedia("(max-width: 768px)").matches) return;

    bar.hidden = false;
    let pastHero = false;
    let atContact = false;

    const nearBottom = () => {
      const doc = document.documentElement;
      const footer = document.querySelector<HTMLElement>(".ft");
      // hide as soon as the footer starts to appear, not only at the very end
      const reserve = (footer?.offsetHeight ?? 0) + 80;
      return window.scrollY + window.innerHeight >= doc.scrollHeight - reserve;
    };

    const sync = () => {
      bar.classList.toggle("is-in", pastHero && !atContact && !nearBottom());
    };

    new IntersectionObserver(
      ([e]) => { pastHero = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); },
      { threshold: 0 },
    ).observe(heroCta);

    new IntersectionObserver(
      ([e]) => { atContact = e.isIntersecting; sync(); },
      { threshold: 0.05 },
    ).observe(contactSec);

    // the observers only fire on threshold crossings; this catches everything
    // in between, including landing at the bottom in one flick
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; sync(); });
    }, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
    sync();
  })();

  /* --- contact form -------------------------------------------------- *
   * No endpoint, and no pretence of one. The two actions are real links to
   * the trainer's chats, so they work with this script absent and cannot be
   * blocked as popups. All this adds is the convenience: validate, then copy
   * what was typed so it can be pasted straight into the conversation.
   * ------------------------------------------------------------------- */
  (() => {
    const form = document.querySelector<HTMLFormElement>("[data-contact]");
    if (!form) return;
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const fallback = form.querySelector<HTMLTextAreaElement>("[data-contact-fallback]");

    form.addEventListener("submit", (e) => e.preventDefault());

    const copyNow = (text: string): boolean => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.setAttribute("aria-hidden", "true");
      ta.style.cssText = "position:fixed;top:0;left:0;width:1px;height:1px;opacity:0";
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      ta.setSelectionRange(0, text.length);
      let ok = false;
      try { ok = document.execCommand("copy"); } catch {}
      document.body.removeChild(ta);
      return ok;
    };

    form.querySelectorAll<HTMLAnchorElement>("[data-go]").forEach((link) => {
      link.addEventListener("click", (e) => {
        const data = new FormData(form);
        const payload = {
          name: String(data.get("name") ?? "").trim(),
          goal: String(data.get("goal") ?? "").trim(),
          contact: String(data.get("contact") ?? "").trim(),
        };

        const errors = validate(payload);
        form.querySelectorAll<HTMLElement>("[data-err]").forEach((el) => {
          el.textContent = errors[el.dataset.err!] ?? "";
        });

        if (Object.keys(errors).length) {
          e.preventDefault();
          form.querySelector<HTMLElement>(`#f-${Object.keys(errors)[0]}`)?.focus();
          return;
        }

        const text = composeHandoffMessage(payload);
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(text).then(
            () => {
              if (status) status.textContent = contact.copied;
              if (fallback) fallback.hidden = true;
            },
            () => {
              const copied = copyNow(text);
              if (copied) {
                if (status) status.textContent = contact.copied;
                if (fallback) fallback.hidden = true;
              } else {
                if (status) status.textContent = contact.copyFailed;
                if (fallback) { fallback.hidden = false; fallback.value = text; }
              }
            },
          );
        } else {
          const copied = copyNow(text);
          if (copied) {
            if (status) status.textContent = contact.copied;
            if (fallback) fallback.hidden = true;
          } else {
            if (status) status.textContent = contact.copyFailed;
            if (fallback) { fallback.hidden = false; fallback.value = text; }
          }
        }
      });
    });
  })();
</script>
