---
/**
 * The form does not pretend to send anything, and it no longer talks about
 * itself. It composes what the visitor typed, copies it to the clipboard and
 * opens the trainer's chat — a real action with a real outcome, in the two
 * channels he actually answers on.
 */
import AutoVideo from "../components/AutoVideo.astro";
import { contact, site } from "../content";
import { videos } from "../content/media";
import { instagramDirectUrl } from "../lib/contact";

const igDirect = instagramDirectUrl(site.instagramHandle);
---
<section class="section section--deep ct" id="contact" aria-labelledby="contact-h">
  <div class="ct-media" aria-hidden="true">
    <AutoVideo
      src={videos.waterCalm.src}
      poster={videos.waterCalm.poster}
      width={videos.waterCalm.width}
      height={videos.waterCalm.height}
      label={videos.waterCalm.label}
    />
    <span class="ct-scrim"></span>
  </div>

  <div class="shell ct-in">
    <div class="ct-copy" data-reveal>
      <span class="eyebrow ct-eyebrow">{contact.eyebrow}</span>
      <h2 id="contact-h">{contact.h2}</h2>
      <span class="waterline-hairline" aria-hidden="true"></span>
      <p class="lead ct-lead">{contact.lead}</p>

      <div class="ct-actions">
        <a class="btn btn-primary" href={contact.ctaTelegram.href}
           target="_blank" rel="noopener noreferrer">{contact.ctaTelegram.label}</a>
        <a class="btn btn-ghost" href={contact.ctaInstagram.href}
           target="_blank" rel="noopener noreferrer">{contact.ctaInstagram.label}</a>
      </div>

      <ul class="ct-handles">
        <li>Telegram <span class="ct-h">{site.telegramHandle}</span></li>
        <li>Instagram <span class="ct-h">{site.instagramHandle}</span></li>
      </ul>
    </div>

    <form class="ct-form" data-contact novalidate data-reveal
          data-tg={contact.ctaTelegram.href} data-ig={igDirect}>
      <h3 class="ct-form-h">{contact.formTitle}</h3>
      <p class="ct-form-hint">{contact.formHint}</p>

      {contact.fields.map((f) => (
        <p class="ct-field">
          <label class="ct-label" for={`f-${f.name}`}>{f.label}</label>
          {f.type === "textarea"
            ? <textarea class="ct-input" id={`f-${f.name}`} name={f.name} rows="3"></textarea>
            : <input class="ct-input" id={`f-${f.name}`} name={f.name} type="text" />}
          <span class="ct-err" data-err={f.name} role="alert"></span>
        </p>
      ))}

      {/* Anchors, not submit buttons. window.open was being suppressed as a
          popup, and a real link cannot be — it also means the handoff still
          works with JavaScript disabled, where the fields are simply a
          prompt for what to write. */}
      <div class="ct-submits">
        <a class="btn btn-primary ct-submit" data-go="tg"
           href={contact.ctaTelegram.href} target="_blank" rel="noopener noreferrer">
          {contact.submitTelegram}
        </a>
        <a class="btn btn-ghost ct-submit" data-go="ig"
           href={igDirect} target="_blank" rel="noopener noreferrer">
          {contact.submitInstagram}
        </a>
      </div>

      <p class="ct-status" data-contact-status role="status" aria-live="polite"></p>
      <textarea class="ct-fallback" data-contact-fallback hidden readonly rows="5"
                aria-label="Текст повідомлення"></textarea>
    </form>
  </div>
</section>
<style>
  .ct {
    position: relative;
    overflow: hidden;
    background: var(--abyss);
    padding-bottom: clamp(2rem, 3.5vw, 3.5rem);
  }
  .ct-media { position: absolute; inset: 0; z-index: var(--z-media); opacity: 0.5; }
  .ct-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg,
      var(--abyss) 0%,
      color-mix(in oklab, var(--abyss) 62%, transparent) 40%,
      var(--abyss) 100%);
  }
  .ct-in {
    position: relative; z-index: var(--z-content);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem); align-items: start;
  }
  .ct-eyebrow { display: block; margin-bottom: 1rem; }
  .ct-lead { margin: 1.25rem 0 2rem; color: var(--foam); }

  .ct-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ct-handles {
    list-style: none; margin: 1.5rem 0 0; padding: 0;
    display: grid; gap: 0.4rem;
    font-family: var(--font-mono); font-size: var(--fs-mono);
    letter-spacing: 0.08em; color: var(--mute);
  }
  .ct-h { color: var(--foam); }

  .ct-form {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line-soft); border-radius: var(--r);
    background: color-mix(in oklab, var(--deep) 80%, transparent);
    backdrop-filter: blur(8px);
  }
  .ct-form-h { margin-bottom: 0.4rem; }
  .ct-form-hint {
    margin-bottom: 1.5rem; font-size: var(--fs-sm);
    line-height: 1.5; color: var(--mute);
  }
  .ct-field { margin: 0 0 1.25rem; max-width: none; }
  .ct-label {
    display: block; margin-bottom: 0.4rem;
    font-family: var(--font-mono); font-size: var(--fs-mono);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute);
  }
  .ct-input {
    width: 100%; min-height: 48px; padding: 0.75rem 0.875rem;
    background: var(--abyss); color: var(--foam);
    border: 1px solid var(--line-soft); border-radius: var(--r);
    transition: border-color var(--t-fast) var(--ease);
  }
  .ct-input:hover { border-color: var(--line); }
  textarea.ct-input { resize: vertical; min-height: 88px; }
  .ct-err {
    display: block; margin-top: 0.35rem; min-height: 1rem;
    font-size: 0.8125rem; color: var(--danger);
  }
  .ct-submits { display: grid; gap: 0.6rem; }
  .ct-submit { width: 100%; }
  .ct-status {
    margin-top: 1rem; min-height: 1.2rem;
    font-size: 0.8125rem; line-height: 1.5; color: var(--caustic);
  }
  .ct-fallback {
    width: 100%; margin-top: 0.75rem; padding: 0.75rem;
    background: var(--abyss); color: var(--foam);
    border: 1px solid var(--line); border-radius: var(--r);
    font-size: 0.8125rem; resize: vertical;
  }

  @media (max-width: 1100px) { .ct-in { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .ct-actions .btn { width: 100%; } }
</style>
