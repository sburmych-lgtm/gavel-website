---
import { pricing } from "../content";
---
<section class="section section--petrol" id="pricing" aria-labelledby="pricing-h">
  <div class="shell">
    <div class="head" data-reveal>
      <div class="head-kicker">
        <span class="num sec-idx">07 / 11</span>
        <span class="eyebrow">{pricing.eyebrow}</span>
      </div>
      <h2 id="pricing-h">{pricing.h2}</h2>
      <span class="waterline-hairline" aria-hidden="true"></span>
      <p class="lead">{pricing.lead}</p>
    </div>

    <ul class="p-list">
      {pricing.tiers.map((t) => (
        <li class:list={["p-item", t.featured && "p-item--f"]} data-reveal>
          <h3 class="p-name">{t.name}</h3>
          {/* One text node, not two. Split across sibling spans, extraction
              yielded "100" and "$" on separate lines — and with ₴ and $ in the
              same list that is a live mis-association risk. */}
          <p class="p-price">
            <span class="num p-val">{t.price}&#8239;<span class="p-cur">{t.currency}</span></span>
          </p>
          {"intro" in t && t.intro ? <p class="p-intro">{t.intro}</p> : null}
          <p class="p-inc">{t.includes}</p>
        </li>
      ))}
    </ul>

    <div class="p-foot" data-reveal>
      <p class="p-note">{pricing.note}</p>
    </div>
  </div>
</section>
<style>
  .p-list {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    list-style: none; margin: 0; padding: 0;
  }
  .p-item {
    display: flex; flex-direction: column; gap: 0.75rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--line-soft); border-radius: var(--r);
    background: color-mix(in oklab, var(--deep) 90%, transparent);
  }
  /* Distinguished by a gold outline, not a fill and not a "popular" badge —
     no popularity data exists. */
  .p-item--f { border-color: var(--gold); border-width: 1px; }
  .p-name { font-size: 1rem; font-weight: 600; margin: 0; color: var(--foam); }
  .p-price { display: flex; align-items: baseline; gap: 0.15rem; margin: 0; }
  .p-val { font-family: var(--font-mono); font-size: var(--fs-num); color: var(--gold); }
  .p-cur { font-family: var(--font-mono); font-size: 1rem; color: var(--gold); }
  .p-inc {
    margin: 0; font-size: var(--fs-sm); line-height: 1.5;
    color: var(--mute);
  }
  /* Subordinate to the standard price — not a second competing figure. */
  .p-intro {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    font-weight: 500;
    color: var(--gold);
  }
  .p-foot {
    margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
    display: grid; gap: 0.875rem;
  }
  .p-note {
    margin: 0; font-size: var(--fs-sm);
    color: var(--mute);
  }
  @media (max-width: 1100px) { .p-list { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
  @media (max-width: 560px) { .p-list { grid-template-columns: 1fr; } }
</style>
