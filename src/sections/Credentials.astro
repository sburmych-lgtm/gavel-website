---
import { credentials } from "../content";
import { photos } from "../content/media";
import { Image } from "astro:assets";
---
<section class="section" id="credentials" aria-labelledby="creds-h">
  <div class="shell">
    <div class="head" data-reveal>
      <div class="head-kicker">
        <span class="num sec-idx">10 / 11</span>
        <span class="eyebrow">{credentials.eyebrow}</span>
      </div>
      <h2 id="creds-h">{credentials.h2}</h2>
      <span class="waterline-hairline" aria-hidden="true"></span>
    </div>

    <div class="cr-grid">
      <div class="cr-cols">
        {credentials.groups.map((g) => (
          <div class="cr-group" data-reveal>
            <h3 class="cr-gt">{g.title}</h3>
            <ul class="cr-items">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <aside class="cr-docs" data-reveal aria-label="Документи та нагороди">
        {/* Framed as documents, not photographs. */}
        <figure class="cr-doc">
          <Image src={photos.champion.src} alt={photos.champion.alt}
                 widths={[320, 520]} sizes="240px" loading="lazy" />
        </figure>
        <figure class="cr-doc">
          <Image src={photos.certificates.src} alt={photos.certificates.alt}
                 widths={[320, 520]} sizes="240px" loading="lazy" />
        </figure>
      </aside>
    </div>
  </div>
</section>
<style>
  .cr-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
  .cr-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.75rem, 3vw, 2.75rem); }
  .cr-gt {
    margin-bottom: 1rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-mono); font-size: var(--fs-mono);
    font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--caustic);
  }
  .cr-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.625rem; }
  .cr-items li { font-size: var(--fs-sm); color: var(--mute); line-height: 1.5; }
  .cr-docs { display: grid; gap: 1rem; }
  .cr-doc {
    margin: 0; padding: 0.5rem;
    border: 1px solid var(--line-soft); border-radius: var(--r);
    background: var(--deep);
  }
  .cr-doc :global(img) { width: 100%; height: auto; display: block; }
  @media (max-width: 1100px) {
    .cr-grid { grid-template-columns: 1fr; }
    .cr-docs { grid-template-columns: repeat(2, 1fr); max-width: 460px; }
  }
  @media (max-width: 560px) { .cr-cols { grid-template-columns: 1fr; } }
</style>
