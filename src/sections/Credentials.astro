---
import { credentials } from "../content";
import { photos } from "../content/media";
import { Image } from "astro:assets";

const docs = [
  { photo: photos.champion, title: "Чемпіон України (Dragon Boat)" },
  { photo: photos.certificates, title: "Сертифікати та дипломи" },
  { photo: photos.certAcademy, title: "Академія Фітнесу України" },
  { photo: photos.trxSeminar, title: "Семінар TRX та тренінг" },
  { photo: photos.certTrainer, title: "Персональний тренер" },
] as const;

const roleFor = (i: number) =>
  i === 0
    ? "active"
    : i === 1
    ? "preview-a"
    : i === 2
    ? "preview-b"
    : i === 3
    ? "preview-c"
    : "preview-d";
---
<section class="section section--deep" id="credentials" aria-labelledby="creds-h">
  <div class="shell">
    <div class="head cr-head" data-reveal>
      <h2 id="creds-h" class="cr-h2">{credentials.h2}</h2>
    </div>

    <div class="cr-grid">
      <div class="cr-cols">
        {credentials.groups.map((g) => (
          <div class="cr-group" data-reveal>
            <h3 class="cr-gt">{g.title}</h3>
            <ul class="cr-items">
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="cr-gallery" data-reveal aria-label="Документи, сертифікати та нагороди">
        <div class="cr-stage" data-creds-stage role="group" aria-label="Галерея кваліфікації">
          {docs.map(({ photo, title }, i) => (
            <div
              class:list={["cr-slot", i === 0 && "is-active"]}
              data-creds-item
              data-creds-role={roleFor(i)}
              data-creds-index={String(i)}
            >
              <div class="cr-frame">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[360, 600, 800]}
                  sizes="(max-width: 900px) 100vw, 420px"
                  loading="lazy"
                />
                <div class="cr-caption">
                  <span class="cr-caption-t">{title}</span>
                </div>
                <button
                  type="button"
                  class="cr-select"
                  data-creds-select
                  hidden={i === 0}
                  tabindex={i === 0 ? -1 : undefined}
                  aria-label={`Переглянути: ${title}`}
                >
                  <span class="cr-select-label">Переглянути</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .cr-head { text-align: center; }
  .cr-h2 { margin-inline: auto; max-width: 32ch; }

  .cr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 420px);
    gap: clamp(2rem, 4.5vw, 3.5rem);
    align-items: start;
  }

  .cr-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }

  .cr-gt {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--caustic);
  }
  .cr-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .cr-items li {
    font-size: var(--fs-sm);
    color: var(--mute);
    line-height: 1.5;
  }

  .cr-gallery {
    min-width: 0;
  }

  .cr-stage {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    grid-template-areas:
      "active active active active"
      "prev-a prev-b prev-c prev-d";
    gap: 0.55rem;
    isolation: isolate;
  }

  .cr-slot {
    min-width: 0;
    min-height: 0;
  }

  .cr-slot[data-creds-role="active"] { grid-area: active; }
  .cr-slot[data-creds-role="preview-a"] { grid-area: prev-a; }
  .cr-slot[data-creds-role="preview-b"] { grid-area: prev-b; }
  .cr-slot[data-creds-role="preview-c"] { grid-area: prev-c; }
  .cr-slot[data-creds-role="preview-d"] { grid-area: prev-d; }

  .cr-slot[data-creds-index="0"] { view-transition-name: creds-doc-0; }
  .cr-slot[data-creds-index="1"] { view-transition-name: creds-doc-1; }
  .cr-slot[data-creds-index="2"] { view-transition-name: creds-doc-2; }
  .cr-slot[data-creds-index="3"] { view-transition-name: creds-doc-3; }
  .cr-slot[data-creds-index="4"] { view-transition-name: creds-doc-4; }

  .cr-frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--abyss);
    border: 1px solid var(--line-soft);
    transition:
      filter var(--t-base) var(--ease),
      box-shadow var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease);
  }

  .cr-slot.is-active .cr-frame {
    aspect-ratio: 4 / 4.9;
    border-color: color-mix(in oklab, var(--gold) 48%, var(--line));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--gold) 42%, transparent),
                0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .cr-slot:not(.is-active) .cr-frame {
    aspect-ratio: 1 / 1;
    filter: saturate(0.82) brightness(0.72);
    cursor: pointer;
  }

  .cr-slot:not(.is-active):hover .cr-frame,
  .cr-slot:not(.is-active):focus-within .cr-frame {
    filter: saturate(1) brightness(0.95);
    border-color: var(--caustic);
  }

  .cr-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cr-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 1.5rem 0.9rem 0.85rem;
    background: linear-gradient(0deg, color-mix(in oklab, var(--abyss) 92%, transparent) 0%, transparent 100%);
    pointer-events: none;
    transition: opacity var(--t-fast) var(--ease);
  }
  .cr-slot:not(.is-active) .cr-caption {
    display: none;
  }
  .cr-caption-t {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--foam);
    line-height: 1.3;
    display: block;
  }

  .cr-select {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: inherit;
    padding: 0;
  }
  .cr-select[hidden] { display: none; }

  .cr-select-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--foam);
    padding: 0.35rem 0.55rem;
    background: color-mix(in oklab, var(--abyss) 85%, transparent);
    backdrop-filter: blur(4px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    opacity: 0;
    transform: translateY(3px);
    transition: opacity var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .cr-slot:not(.is-active):hover .cr-select-label,
  .cr-slot:not(.is-active):focus-within .cr-select-label {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1024px) {
    .cr-grid {
      grid-template-columns: 1fr;
    }
    .cr-stage {
      max-width: 520px;
    }
  }

  @media (max-width: 560px) {
    .cr-cols {
      grid-template-columns: 1fr;
    }
    .cr-stage {
      max-width: 100%;
    }
    .cr-select-label {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cr-slot { view-transition-name: none; }
  }
</style>
