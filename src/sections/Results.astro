---
import BeforeAfter from "../components/BeforeAfter.astro";
import { results } from "../content";
---
<section class="section section--deep" id="results" aria-labelledby="results-h">
  <div class="shell">
    <div class="head" data-reveal>
      <span class="eyebrow">{results.eyebrow}</span>
      <h2 id="results-h">{results.h2}</h2>
    </div>

    <div data-reveal>
      <BeforeAfter />
    </div>

    <p class="r-note" data-reveal>{results.disclaimer}</p>
  </div>
</section>
<style>
  .r-note {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
    font-size: var(--fs-sm);
    color: var(--mute);
  }
</style>
