---
import MediaFrame from "../components/MediaFrame.astro";
import AutoVideo from "../components/AutoVideo.astro";
import { athlete } from "../content";
import { photos, videos } from "../content/media";
import { Image } from "astro:assets";
---
<section class="section section--deep" id="athlete" aria-labelledby="athlete-h">
  <div class="shell">
    <div class="head a-head" data-reveal>
      <span class="eyebrow">{athlete.eyebrow}</span>
      {/* Two-part headline: the promise, then the canoe line that used to sit
          in the body copy. The second part is set smaller so the composition
          still has one dominant line. */}
      <h2 id="athlete-h" class="a-h2">
        {athlete.h2}
        <span class="a-h2-sub">{athlete.h2Sub}</span>
      </h2>
    </div>

    <div class="a-grid">
      <div class="a-lead" data-reveal>
        <Image
          src={photos.onBeach.src}
          alt={photos.onBeach.alt}
          widths={[600, 900, 1122]}
          sizes="(max-width: 1100px) 100vw, 620px"
          class="a-img"
          loading="lazy"
        />
      </div>
      <div class="a-side">
        <div data-reveal>
          <MediaFrame ratio="16 / 9" caption={videos.dragonboat.label}>
            <AutoVideo
              src={videos.dragonboat.src}
              poster={videos.dragonboat.poster}
              width={videos.dragonboat.width}
              height={videos.dragonboat.height}
              label={videos.dragonboat.label}
            />
          </MediaFrame>
        </div>
        <div data-reveal>
          <Image
            src={photos.canoe2.src}
            alt={photos.canoe2.alt}
            widths={[400, 620, 900]}
            sizes="(max-width: 1100px) 100vw, 420px"
            class="a-img a-img--sm"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    {/* The three offers. Rows with a hairline and a mono numeral — the same
        grammar as the Method section, so this reads as part of the system
        rather than a card grid bolted on. */}
    <p class="a-offer-lead" data-reveal>{athlete.offerLead}</p>
    <ol class="a-offers">
      {athlete.offers.map((o) => (
        <li class="a-offer" data-reveal>
          <span class="num a-offer-n">{o.n}</span>
          <div class="a-offer-body">
            <h3 class="a-offer-t">{o.title}</h3>
            <p class="a-offer-b">{o.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .a-h2 { max-width: 22ch; }
  .a-h2-sub {
    display: block;
    margin-top: 1rem;
    max-width: 46ch;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--mute);
  }

  .a-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }
  .a-side { display: grid; gap: clamp(1rem, 2.5vw, 2rem); }
  .a-img {
    width: 100%; height: auto; object-fit: cover;
    border: 1px solid var(--line); border-radius: var(--r);
  }
  .a-img--sm { aspect-ratio: 4 / 3; }

  .a-offer-lead {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    color: var(--foam);
  }

  .a-offers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .a-offer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .a-offer-n {
    display: block;
    font-size: 1rem;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .a-offer-t { margin-bottom: 0.625rem; }
  .a-offer-b { color: var(--mute); font-size: var(--fs-body); }

  @media (max-width: 1100px) {
    .a-grid { grid-template-columns: 1fr; }
    .a-offers { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
