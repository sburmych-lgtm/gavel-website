---
/**
 * The mandatory Before/After slider, with a case switcher.
 *
 * Every case is a real pair. The client archive is mostly two-up composites,
 * so each was cut at its measured seam by scripts/build-results.mjs — the
 * seams are not at 50%. Halves within a case share identical dimensions,
 * otherwise the wipe tears where they meet.
 *
 * The frame's aspect follows the active case rather than being fixed: the
 * archive shots run to 0.40 while the studio pair is 0.75, and forcing one
 * ratio on all of them would letterbox most of the section.
 *
 * Three input methods, none optional: pointer, keyboard, and click-to-position
 * anywhere on the frame. With JS off the "after" image renders with both
 * labels visible and the thumbnails are plain links to nothing — the section
 * still communicates.
 */
import { resultsCases } from "../content/media";
import { results } from "../content";

const cases = resultsCases;
const first = cases[0];
---

<div class="ba" data-ba>
  <script
    type="application/json"
    data-ba-cases
    is:inline
    set:html={JSON.stringify(cases)}
  />

  <div class="ba-main">
    <div
      class="ba-stage"
      data-ba-stage
      style={`--pos:50%;--ratio:${first.ratio}`}
    >
      <img
        class="ba-img"
        data-ba-after
        src={first.after}
        alt={`Після — ${first.alt}`}
        width={first.w}
        height={first.h}
        loading="lazy"
        decoding="async"
        draggable="false"
      />

      <div class="ba-clip" data-ba-clip>
        <img
          class="ba-img"
          data-ba-before
          src={first.before}
          alt={`До — ${first.alt}`}
          width={first.w}
          height={first.h}
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </div>

      <span class="ba-tag ba-tag--l" data-ba-tag aria-hidden="true">{results.labelBefore}</span>
      <span class="ba-tag ba-tag--r" data-ba-tag aria-hidden="true">{results.labelAfter}</span>

      <div
        class="ba-handle"
        data-ba-handle
        role="slider"
        tabindex="0"
        aria-label="Порівняння до і після"
        aria-valuemin="12"
        aria-valuemax="88"
        aria-valuenow="50"
        aria-valuetext="50% — частка кадру «до»"
      >
        <span class="ba-line" aria-hidden="true"></span>
        <span class="ba-grip" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <div class="ba-side">
    <div class="ba-meta">
      <p class="ba-title" data-ba-title>{first.title}</p>
      <p class="ba-sub" data-ba-sub>{first.sub}</p>
    </div>

    <div class="ba-thumbs" role="tablist" aria-label="Випадки клієнтів">
      {cases.map((c, i) => (
        <button
          type="button"
          role="tab"
          class:list={["ba-thumb", i === 0 && "is-on"]}
          data-ba-thumb={i}
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={c.title}
        >
          <img src={c.thumb} alt="" width="90" height="120" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>

    <p class="ba-count num" data-ba-count>01 / {String(cases.length).padStart(2, "0")}</p>
  </div>
</div>

<style>
  .ba {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }

  /* The frame is sized from its HEIGHT, not from the column width. Stretching
     it to the column and capping the height made the box wider than the
     photograph's ratio, so object-fit: cover cropped a full-body shot down to
     a chest. Deriving width from a fixed height keeps every case whole. */
  .ba-stage {
    position: relative;
    --h: min(72vh, 660px);
    height: var(--h);
    width: calc(var(--h) * var(--ratio));
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--deep);
    /* the pointer path owns horizontal drags; without this a swipe on a
       phone scrolls the page instead of moving the handle */
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
  }

  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .ba-clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos, 50%)) 0 0);
  }

  .ba-tag {
    position: absolute;
    top: 0.875rem;
    z-index: 3;
    padding: 0.3rem 0.6rem;
    background: color-mix(in oklab, var(--abyss) 76%, transparent);
    backdrop-filter: blur(4px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--foam);
    pointer-events: none;
  }
  .ba-tag--l { left: 0.875rem; }
  .ba-tag--r { right: 0.875rem; }
  /* suppressed for the case whose labels are burnt into the photograph */
  .ba-stage[data-baked="true"] .ba-tag { display: none; }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos, 50%);
    z-index: 4;
    width: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    cursor: ew-resize;
    touch-action: none;
  }
  .ba-line {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 2px; margin-left: -1px;
    background: var(--foam);
    opacity: 0.9;
  }
  .ba-grip {
    position: relative;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--foam);
    border: 2px solid var(--foam);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--abyss) 40%, transparent);
  }
  .ba-grip::before, .ba-grip::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 7px; height: 7px;
    border-top: 2px solid var(--ink);
    border-right: 2px solid var(--ink);
  }
  .ba-grip::before { left: 11px;  transform: translateY(-50%) rotate(-135deg); }
  .ba-grip::after  { right: 11px; transform: translateY(-50%) rotate(45deg); }

  .ba-handle:focus-visible { outline: none; }
  .ba-handle:focus-visible .ba-grip {
    outline: 2px solid var(--caustic);
    outline-offset: 3px;
  }

  /* ---- case switcher ---- */

  .ba-side { display: grid; gap: 1.25rem; }

  .ba-meta { padding-bottom: 1rem; border-bottom: 1px solid var(--line-soft); }
  .ba-title { margin: 0 0 0.35rem; font-weight: 600; font-size: 1rem; }
  .ba-sub { margin: 0; font-size: 0.8125rem; line-height: 1.5; color: var(--mute); }

  .ba-thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .ba-thumb {
    padding: 0;
    min-height: 44px;
    background: var(--deep);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease),
                opacity var(--t-fast) var(--ease);
    opacity: 0.55;
  }
  .ba-thumb img {
    width: 100%; height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .ba-thumb:hover { opacity: 0.85; border-color: var(--line); }
  .ba-thumb.is-on {
    opacity: 1;
    border-color: var(--gold);
  }

  .ba-count {
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    color: var(--mute);
  }

  @media (max-width: 1100px) {
    .ba { grid-template-columns: 1fr; }
    .ba-stage { --h: min(64vh, 540px); }
    .ba-thumbs { grid-template-columns: repeat(5, 1fr); max-width: 420px; }
  }
  /* Below this the height-driven box gets too narrow to read, so hand control
     back to the width and let the ratio set the height. */
  @media (max-width: 640px) {
    .ba-stage {
      width: 100%;
      height: auto;
      aspect-ratio: var(--ratio);
      max-height: none;
    }
  }
  @media (max-width: 560px) {
    .ba-thumbs { max-width: none; }
  }
</style>
