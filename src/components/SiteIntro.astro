---
/**
 * One-shot open on the first visit of a session.
 *
 * Film is IMG_1865, cropped to its own picture and run edge to edge on
 * black. The last stretch of it the veil
 * fades and the lockup flies into .hdr-brand. Return visits, reduced motion,
 * and no-JS skip it.
 *
 * The landscape film and the portrait film do not end on the same artwork:
 * the landscape cut resolves to a wide lockup with IGOR GAVRILEYKO set on ONE
 * line, while the portrait cut and the header both carry the compact two-line
 * lockup. No translate/scale turns one into the other, which is why the
 * landscape flight carries a second layer — the header's own artwork — and
 * cross-dissolves into it mid-flight with the two monograms locked together.
 * That flight ends on the exact rect and the exact image the header is about
 * to show, so the handoff is a swap of identical pixels.
 */
import { intro } from "../content";
import { videos, logo } from "../content/media";

const open = videos.open;
const openMobile = videos.openMobile;
---

<div class="intro" data-intro hidden role="dialog" aria-label={intro.label} aria-modal="true">
  <div class="intro-veil" data-intro-veil></div>
  <div class="intro-slot">
    <video
      class="intro-film"
      data-intro-film
      muted
      playsinline
      webkit-playsinline
      disablepictureinpicture
      x-webkit-airplay="deny"
      preload="auto"
      poster={open.poster}
      data-src-desktop={open.src}
      data-src-mobile={openMobile.src}
      data-poster-desktop={open.poster}
      data-poster-mobile={openMobile.poster}
      data-mark-desktop={open.mark}
      data-mark-mobile={openMobile.mark}
      width={open.width}
      height={open.height}
      aria-hidden="true"
    ></video>
  </div>
  <div class="intro-flyer" data-intro-flyer aria-hidden="true">
    <img
      class="intro-flyer-mark"
      data-intro-flyer-mark
      src={open.mark}
      alt=""
      width="603"
      height="484"
      decoding="async"
    />
    <img
      class="intro-flyer-brand"
      data-intro-flyer-brand
      src={logo.full.src}
      alt=""
      width={logo.full.width}
      height={logo.full.height}
      decoding="async"
    />
  </div>
  <button type="button" class="intro-skip" data-intro-skip>{intro.skip}</button>
</div>

<style>
  /* Pure black, not --abyss. The film's first three quarters of a second are
     a water plate narrower than the frame, matted to #000 on both sides —
     about 66 px left and 77 px right of a 1280-wide frame, so ~100 px each
     side once it is scaled up. Against the site's #060e12 those mattes are
     the darker colour, and the seam reads as a vertical rule down each side
     of the picture. Matching the stage to the film's own black closes it. */
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    overflow: hidden;
    pointer-events: auto;
    background: #000;
  }
  :global(html.is-intro) .intro[hidden] { display: block !important; }

  .intro-veil {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  .intro-slot {
    position: absolute;
    inset: 0;
    display: grid;
    /* Definite tracks. The implicit auto row left the film's height:100%
       resolving against an indefinite size, so it fell back to auto and the
       element took the film's own aspect instead of the stage's box —
       1905x1216 inside a 1905x920 stage. */
    grid-template: 100% / 100%;
    place-items: center;
    pointer-events: none;
  }

  /* The film is cropped to its own picture, so it can run edge to edge. The
     element always fills the stage and object-fit decides the rest; contain
     is the floor, because it never crops the lockup. */
  .intro-film {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  /* Fill the window wherever cover cannot reach the lockup. The wordmark sits
     at 0.82 of the frame height and the mark at 0.79 of its width, so past
     9/4 the crop starts eating the wordmark off the bottom and below 5/4 it
     eats the mark off the side. Outside that band the film letterboxes — on a
     black stage that reads as the picture being smaller, not as a border. */
  @media (min-aspect-ratio: 5 / 4) and (max-aspect-ratio: 9 / 4) {
    .intro-film { object-fit: cover; }
  }

  @media (max-width: 768px), (orientation: portrait) {
    .intro-film {
      width: min(100vw, calc(100svh * 9 / 16));
      height: min(100svh, calc(100vw * 16 / 9));
      object-fit: fill;
    }
  }

  /* The flyer is a box, not an image: it is laid out on the mark's rect in
     the film and scaled down onto the header rect, and both lockups ride
     inside it so one transform keeps them registered to each other. */
  .intro-flyer {
    position: fixed;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transform-origin: 0 0;
  }
  .intro-flyer img {
    position: absolute;
    display: block;
    max-width: none;
    will-change: opacity;
  }
  .intro-flyer-mark { left: 0; top: 0; width: 100%; height: 100%; }
  .intro-flyer-brand { opacity: 0; }

  .intro-skip {
    position: absolute;
    right: var(--gut);
    bottom: calc(var(--gut) + env(safe-area-inset-bottom));
    z-index: 10;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--foam);
    background: color-mix(in oklab, var(--abyss) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--foam) 34%, transparent);
    border-radius: var(--r);
    min-height: 44px;
    padding: 0.55rem 1rem;
    cursor: pointer;
  }
  .intro-skip:hover { border-color: var(--foam); }
</style>

<script>
  /* keep in sync with the guard in Base.astro */
  const KEY = "ig-open-1851-m9";

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-intro]");
  const veil = document.querySelector<HTMLElement>("[data-intro-veil]");
  const film = document.querySelector<HTMLVideoElement>("[data-intro-film]");
  const flyer = document.querySelector<HTMLElement>("[data-intro-flyer]");
  const flyerMark = document.querySelector<HTMLImageElement>("[data-intro-flyer-mark]");
  const flyerBrand = document.querySelector<HTMLImageElement>("[data-intro-flyer-brand]");
  const skip = document.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const brand = document.querySelector<HTMLElement>("[data-hdr-brand] img");
  const burger = document.querySelector<HTMLElement>("[data-hdr-toggle]");

  const seen = () => {
    try { return sessionStorage.getItem(KEY) === "1"; }
    catch { return true; }
  };
  const remember = () => {
    try { sessionStorage.setItem(KEY, "1"); } catch { /* ignore */ }
  };

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as unknown as { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (!stage || !veil || !film || !flyer || !flyerMark || !flyerBrand || !skip || (!brand && !burger)) {
    root.classList.remove("is-intro");
  } else if (!root.classList.contains("is-intro") || seen() || reduced || saveData) {
    root.classList.remove("is-intro");
  } else {
    root.setAttribute("data-intro-live", "1");

    /* MARK is the lockup's rect inside the film frame — it must stay equal to
       the crop in scripts/build-media.sh that cuts the mark out of the last
       frame. BRAND_AT is where the header's own artwork has to sit inside
       that mark for the two IG monograms to coincide: fitted by maximising
       mask overlap between the two monograms (IoU 0.69 — they are separate
       renderings of the same mark, one lit in 3D and one flat, so they never
       coincide exactly). Landscape only. The portrait mark and the header
       lockup are already the same composition, so that flight stays a
       straight translate + scale. */
    const isPortraitMobile = window.matchMedia("(max-width: 768px), (orientation: portrait)").matches;
    type Rect = { x: number; y: number; w: number; h: number };
    const cfg = isPortraitMobile
      ? {
          FILM_W: 720,
          FILM_H: 1280,
          MARK: { x: 114, y: 362, w: 536, h: 592 },
          BRAND_AT: null as Rect | null,
          REVEAL_S: 0.50,
          src: film.dataset.srcMobile || film.dataset.srcDesktop || "",
          poster: film.dataset.posterMobile || film.dataset.posterDesktop || "",
          mark: film.dataset.markMobile || film.dataset.markDesktop || "",
        }
      : {
          FILM_W: 1128,
          FILM_H: 720,
          MARK: { x: 309, y: 197, w: 518, h: 395 },
          BRAND_AT: { x: 0.01985, y: -0.06534, w: 0.94878, h: 1.20397 } as Rect | null,
          REVEAL_S: 0.50,
          src: film.dataset.srcDesktop || "",
          poster: film.dataset.posterDesktop || "",
          mark: film.dataset.markDesktop || "",
        };

    if (cfg.poster) film.poster = cfg.poster;
    if (cfg.mark) flyerMark.src = cfg.mark;

    /* Where MARK actually lands on screen. The <video> element always fills
       the stage — its box is never rewritten per frame, which is what iOS
       stalls on — so the drawn picture is the element box only under `fill`.
       Under cover it is larger and cropped, under contain smaller and padded,
       and MARK is measured in film pixels either way. */
    const flyerBox = () => {
      const r = film.getBoundingClientRect();
      if (r.width < 8 || r.height < 8) {
        const k = Math.min(innerWidth / cfg.FILM_W, innerHeight / cfg.FILM_H);
        return {
          left: (innerWidth - cfg.FILM_W * k) / 2 + cfg.MARK.x * k,
          top: (innerHeight - cfg.FILM_H * k) / 2 + cfg.MARK.y * k,
          width: cfg.MARK.w * k,
          height: cfg.MARK.h * k,
        };
      }
      const fit = getComputedStyle(film).objectFit;
      let kx: number;
      let ky: number;
      if (fit === "fill") {
        kx = r.width / cfg.FILM_W;
        ky = r.height / cfg.FILM_H;
      } else {
        kx = ky = fit === "cover"
          ? Math.max(r.width / cfg.FILM_W, r.height / cfg.FILM_H)
          : Math.min(r.width / cfg.FILM_W, r.height / cfg.FILM_H);
      }
      const left = r.left + (r.width - cfg.FILM_W * kx) / 2;
      const top = r.top + (r.height - cfg.FILM_H * ky) / 2;
      return {
        left: left + cfg.MARK.x * kx,
        top: top + cfg.MARK.y * ky,
        width: cfg.MARK.w * kx,
        height: cfg.MARK.h * ky,
      };
    };

    const placeFlyer = (box: { left: number; top: number; width: number; height: number }) => {
      flyer.style.left = `${box.left}px`;
      flyer.style.top = `${box.top}px`;
      flyer.style.width = `${box.width}px`;
      flyer.style.height = `${box.height}px`;
      flyer.style.transform = "none";
    };

    /* Lay the header artwork inside the flyer at the fitted anchor, so its
       monogram sits on the film mark's monogram. Returns the box in
       flyer-local pixels; the flight scales that box onto the header rect. */
    const placeBrand = (at: Rect, box: { width: number; height: number }) => {
      const left = at.x * box.width;
      const top = at.y * box.height;
      const width = at.w * box.width;
      const height = at.h * box.height;
      flyerBrand.style.left = `${left}px`;
      flyerBrand.style.top = `${top}px`;
      flyerBrand.style.width = `${width}px`;
      flyerBrand.style.height = `${height}px`;
      return { left, top, width, height };
    };

    let watchId = 0;

    const finish = () => {
      remember();
      root.classList.remove("is-intro", "is-intro-landed");
      root.removeAttribute("data-intro-live");
      stage.hidden = true;
      flyer.style.opacity = "0";
      try { film.pause(); } catch { /* ignore */ }
      film.removeAttribute("src");
      cancelAnimationFrame(watchId);
      window.removeEventListener("resize", onResize);
      document.removeEventListener("keydown", onKey);
      window.removeEventListener("wheel", onNudge);
    };

    let revealing = false;
    let docking = false;

    const onResize = () => {
      if (docking) return;
      if (revealing) placeFlyer(flyerBox());
    };

    const fadeOut = (el: HTMLElement, duration: number) =>
      el.animate(
        [{ opacity: getComputedStyle(el).opacity || "1" }, { opacity: "0" }],
        { duration, easing: "linear", fill: "forwards" },
      );

    /* Driven off rAF, with `timeupdate` kept as a floor under it: that event
       alone fires about four times a second, so the reveal could start a
       quarter of a second late and the veil would still be at 40% when the
       film ended and the dock cut it to zero. `remaining` is the film's own
       time left, so the fade always lands on the last frame however late this
       is called. */
    const startReveal = (remaining: number) => {
      if (revealing || docking) return;
      revealing = true;
      const ms = Math.max(180, Math.round(remaining * 1000));
      placeFlyer(flyerBox());
      flyer.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: Math.min(240, ms), easing: "linear", fill: "forwards" },
      );
      fadeOut(film, ms);
      fadeOut(veil, ms);
      fadeOut(skip, 220);
      skip.style.pointerEvents = "none";
    };

    const dock = () => {
      if (docking) return;
      docking = true;
      remember();
      skip.style.opacity = "0";
      skip.style.pointerEvents = "none";
      try { film.pause(); } catch { /* ignore */ }
      cancelAnimationFrame(watchId);
      const animEls = [film, veil, flyer, flyerMark, flyerBrand, skip];
      for (const el of animEls) {
        for (const a of el.getAnimations()) a.cancel();
      }

      const from = flyerBox();
      placeFlyer(from);
      flyer.style.opacity = "1";
      film.style.opacity = "0";
      veil.style.opacity = "0";

      const targetEl = brand || burger;
      if (!targetEl) { abort(); return; }
      const to = targetEl.getBoundingClientRect();
      if (from.width < 8 || to.height < 8) { abort(); return; }

      const at = cfg.BRAND_AT;
      const morph = Boolean(at && brand && flyerBrand.complete && flyerBrand.naturalWidth > 0);

      let tx: number;
      let ty: number;
      let s: number;
      if (morph) {
        /* Land the header's own artwork on the header's own rect, so the
           final swap is one image for the identical image. */
        const b = placeBrand(at as Rect, from);
        s = to.width / b.width;
        tx = to.left - from.left - s * b.left;
        ty = to.top - from.top - s * b.top;
      } else {
        s = to.height / from.height;
        tx = to.left + to.width / 2 - from.left - (s * from.width) / 2;
        ty = to.top + to.height / 2 - from.top - (s * from.height) / 2;
      }

      /* One curve, two screen sizes: a fixed 640 ms made the landscape flight
         cover half again the distance on the same clock, so its middle
         whipped while both ends sat still. Scale the clock with the distance
         the mark is seen to travel — the transform origin is the corner, so
         its translation alone understates that by more than half. */
      const dist = Math.hypot(
        tx + (s - 1) * (from.width / 2),
        ty + (s - 1) * (from.height / 2),
      );
      const duration = Math.min(820, Math.max(600, Math.round(dist * 1.25)));
      const easing = "cubic-bezier(0.28, 0, 0.06, 1)";

      const fly = flyer.animate(
        [
          { transform: "none" },
          { transform: `translate(${tx}px, ${ty}px) scale(${s})` },
        ],
        { duration, easing, fill: "forwards" },
      );

      if (morph) {
        /* Late and quick. The monograms line up, but the wordmarks cannot —
           one line against two — so the swap has to happen small: run it at
           0.14 of the flight and the two wordmarks are both legible at ~480px
           and read as a smear. At these offsets the lockup is through 130px
           on its way to 80px, where the wordmark is a gold hairline either
           way and the change reads as the mark resolving into the brand.
           The windows overlap so the gold never dips: fade both symmetrically
           and the black shows through the middle of the swap. */
        flyerBrand.animate(
          [
            { opacity: 0, offset: 0 },
            { opacity: 0, offset: 0.46 },
            { opacity: 1, offset: 0.60 },
            { opacity: 1, offset: 1 },
          ],
          { duration, easing: "linear", fill: "forwards" },
        );
        flyerMark.animate(
          [
            { opacity: 1, offset: 0 },
            { opacity: 1, offset: 0.54 },
            { opacity: 0, offset: 0.68 },
            { opacity: 0, offset: 1 },
          ],
          { duration, easing: "linear", fill: "forwards" },
        );
      }

      const settle = () => {
        /* Light the real lockup under the flyer before anything fades. The
           page stays locked — and the backdrop's frame preload stays parked —
           until finish(). */
        root.classList.add("is-intro-landed");
        /* After a morph the flyer and the header lockup are the same image on
           the same rect, so the flyer rides the stage out at full opacity and
           the gold never dips: fading it separately left the mark at 45% for
           a beat while the black above it was still clearing. */
        const fade = morph
          ? null
          : flyer.animate(
              [{ opacity: 1 }, { opacity: 0 }],
              { duration: 160, easing: "linear", fill: "forwards" },
            );
        const gone = stage.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 240, easing: "ease-in", fill: "forwards" },
        );
        Promise.all([
          fade ? fade.finished.catch(() => {}) : Promise.resolve(),
          gone.finished.catch(() => {}),
        ]).then(finish);
      };
      fly.finished.then(settle).catch(settle);
    };

    const abort = () => {
      flyer.style.opacity = "0";
      film.style.opacity = "0";
      veil.style.opacity = "0";
      finish();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") dock();
    };
    const armedAt = performance.now() + 400;
    const onNudge = (e: Event) => {
      if (performance.now() < armedAt) return;
      if (e instanceof WheelEvent && Math.abs(e.deltaY) + Math.abs(e.deltaX) < 10) return;
      dock();
    };

    const src = cfg.src;
    if (!src) {
      abort();
    } else {
      stage.hidden = false;
      film.muted = true;
      film.defaultMuted = true;
      film.playsInline = true;
      film.setAttribute("playsinline", "");
      film.setAttribute("webkit-playsinline", "true");
      film.setAttribute("muted", "");
      try { film.disableRemotePlayback = true; } catch { /* ignore */ }
      film.preload = "auto";
      film.src = src;

      let playLock = false;
      const tryPlay = () => {
        if (docking || playLock) return;
        if (!film.paused && film.currentTime > 0.05) return;
        film.muted = true;
        playLock = true;
        const play = film.play();
        if (play && typeof play.finally === "function") {
          play.catch(() => {});
          play.finally(() => { playLock = false; });
        } else {
          playLock = false;
        }
      };
      film.addEventListener("loadeddata", tryPlay);
      film.addEventListener("canplay", tryPlay);
      tryPlay();
      window.setTimeout(tryPlay, 250);
      window.setTimeout(tryPlay, 900);

      const tick = () => {
        if (docking) return;
        const d = film.duration;
        if (!d || !isFinite(d)) return;
        const remaining = d - film.currentTime;
        if (!revealing && remaining <= cfg.REVEAL_S) startReveal(remaining);
        /* One frame of slack: `ended` can trail the last painted frame, and
           that gap showed as a hold before the flight left. */
        if (remaining <= 0.04) dock();
      };
      const watch = () => {
        watchId = requestAnimationFrame(watch);
        tick();
      };
      watchId = requestAnimationFrame(watch);
      /* rAF is the accurate driver; `timeupdate` is the floor under it. A tab
         the compositor has parked — occluded window, background tab — stops
         serving frames while the media element keeps running, and without
         this the reveal would simply never be reached. */
      film.addEventListener("timeupdate", tick);

      film.addEventListener("ended", dock, { once: true });
      film.addEventListener("error", () => {
        if (!docking) abort();
      }, { once: true });

      const skipToDock = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        dock();
      };
      skip.addEventListener("click", skipToDock);
      stage.addEventListener("click", (e) => {
        if (film.paused || film.currentTime < 0.08) {
          e.preventDefault();
          e.stopPropagation();
          tryPlay();
          return;
        }
        skipToDock(e);
      });
      document.addEventListener("keydown", onKey);
      window.addEventListener("wheel", onNudge, { passive: true });
      window.addEventListener("resize", onResize);

      window.setTimeout(() => {
        if (docking || !root.classList.contains("is-intro")) return;
        if (film.currentTime < 0.05) abort();
      }, 4500);
      window.setTimeout(() => {
        if (root.classList.contains("is-intro") && !docking) dock();
      }, 10000);
    }
  }
</script>
