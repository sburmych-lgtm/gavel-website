---
/**
 * One-shot open on the first visit of a session.
 *
 * Film is IMG_1851. On phones the 16:9 is cover-cropped (sides go) so the
 * water fills the screen; a blurred poster wash sits behind so nothing
 * reads as empty black. The last 0.6 s the veil fades and the lockup
 * flies into .hdr-brand. Return visits, reduced motion, and no-JS skip it.
 */
import { intro } from "../content";
import { videos } from "../content/media";

const open = videos.open;
---

<div class="intro" data-intro hidden role="dialog" aria-label={intro.label} aria-modal="true">
  <img
    class="intro-wash"
    data-intro-wash
    src={open.poster}
    alt=""
    width={open.width}
    height={open.height}
    decoding="async"
    aria-hidden="true"
  />
  <div class="intro-veil" data-intro-veil></div>
  <video
    class="intro-film"
    data-intro-film
    muted
    playsinline
    webkit-playsinline
    disablepictureinpicture
    x-webkit-airplay="deny"
    preload="auto"
    poster={open.poster}
    data-src={open.src}
    width={open.width}
    height={open.height}
    aria-hidden="true"
  ></video>
  <img
    class="intro-flyer"
    data-intro-flyer
    src={open.mark}
    alt=""
    width="603"
    height="484"
    decoding="async"
  />
  <button type="button" class="intro-skip" data-intro-skip>{intro.skip}</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    overflow: hidden;
    pointer-events: auto;
    background: var(--abyss);
  }
  :global(html.is-intro) .intro[hidden] { display: block !important; }

  /* Blurred water, not empty black, in any gap the film does not cover. */
  .intro-wash {
    position: absolute;
    inset: -18%;
    width: 136%;
    height: 136%;
    max-width: none;
    object-fit: cover;
    filter: blur(32px) saturate(1.2) brightness(0.62);
    pointer-events: none;
  }

  .intro-veil {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--abyss) 38%, transparent);
    pointer-events: none;
  }

  .intro-film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .intro-flyer {
    position: fixed;
    left: 0;
    top: 0;
    width: 1px;
    height: auto;
    max-width: none;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transform-origin: 50% 50%;
  }

  .intro-skip {
    position: absolute;
    right: var(--gut);
    bottom: calc(var(--gut) + env(safe-area-inset-bottom));
    z-index: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--foam);
    background: color-mix(in oklab, var(--abyss) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--foam) 34%, transparent);
    border-radius: var(--r);
    min-height: 44px;
    padding: 0.55rem 1rem;
    cursor: pointer;
  }
  .intro-skip:hover { border-color: var(--foam); }
</style>

<script>
  const KEY = "ig-open-1851-m2";
  const FILM_W = 1280;
  const FILM_H = 720;
  const MARK = { x: 293, y: 94, w: 603, h: 484 };
  const REVEAL_S = 0.62;

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>("[data-intro]");
  const veil = document.querySelector<HTMLElement>("[data-intro-veil]");
  const wash = document.querySelector<HTMLElement>("[data-intro-wash]");
  const film = document.querySelector<HTMLVideoElement>("[data-intro-film]");
  const flyer = document.querySelector<HTMLImageElement>("[data-intro-flyer]");
  const skip = document.querySelector<HTMLButtonElement>("[data-intro-skip]");
  const brand = document.querySelector<HTMLElement>("[data-hdr-brand] img");

  const seen = () => {
    try { return sessionStorage.getItem(KEY) === "1"; }
    catch { return true; }
  };
  const remember = () => {
    try { sessionStorage.setItem(KEY, "1"); } catch { /* ignore */ }
  };

  if (!stage || !veil || !film || !flyer || !skip || !brand) {
    root.classList.remove("is-intro");
  } else if (!root.classList.contains("is-intro") || seen()) {
    root.classList.remove("is-intro");
  } else {
    root.setAttribute("data-intro-live", "1");

    /* Cover mapping of the lockup — same math as object-fit: cover + center.
       The <video> size is CSS, never rewritten per frame (iOS stalls if the
       playing element's box changes). */
    const coverBox = () => {
      const vw = innerWidth;
      const vh = innerHeight;
      const k = Math.max(vw / FILM_W, vh / FILM_H);
      const ox = (vw - FILM_W * k) / 2;
      const oy = (vh - FILM_H * k) / 2;
      return {
        left: ox + MARK.x * k,
        top: oy + MARK.y * k,
        width: MARK.w * k,
        height: MARK.h * k,
      };
    };

    /* Portrait cover crops the wordmark. At the hand-off, sit the full
       lockup in the viewport; the wash is the ground around it. */
    const fitBox = () => {
      const vw = innerWidth;
      const vh = innerHeight;
      const padX = Math.max(22, Math.round(vw * 0.07));
      const padY = Math.max(52, Math.round(vh * 0.1));
      const k = Math.min((vw - padX * 2) / MARK.w, (vh - padY * 2) / MARK.h);
      const width = MARK.w * k;
      const height = MARK.h * k;
      return { left: (vw - width) / 2, top: (vh - height) / 2, width, height };
    };

    const flyerBox = () =>
      innerHeight > innerWidth * 1.05 ? fitBox() : coverBox();

    const placeFlyer = (box: { left: number; top: number; width: number; height: number }) => {
      flyer.style.left = `${box.left}px`;
      flyer.style.top = `${box.top}px`;
      flyer.style.width = `${box.width}px`;
      flyer.style.height = `${box.height}px`;
      flyer.style.transform = "translate(0, 0) scale(1)";
      flyer.style.transformOrigin = "50% 50%";
    };

    const finish = () => {
      remember();
      root.classList.remove("is-intro");
      root.removeAttribute("data-intro-live");
      stage.hidden = true;
      flyer.style.opacity = "0";
      try { film.pause(); } catch { /* ignore */ }
      film.removeAttribute("src");
      window.removeEventListener("resize", onResize);
      document.removeEventListener("keydown", onKey);
      window.removeEventListener("wheel", onNudge);
    };

    let revealing = false;
    let docking = false;

    const onResize = () => {
      if (docking) return;
      if (revealing) placeFlyer(flyerBox());
    };

    const fadeOut = (el: HTMLElement, duration: number) =>
      el.animate(
        [{ opacity: getComputedStyle(el).opacity || "1" }, { opacity: "0" }],
        { duration, easing: "linear", fill: "forwards" },
      );

    const startReveal = () => {
      if (revealing || docking) return;
      revealing = true;
      const portrait = innerHeight > innerWidth * 1.05;
      placeFlyer(flyerBox());
      flyer.animate(
        [{ opacity: 0 }, { opacity: 1 }],
        { duration: portrait ? 180 : 240, easing: "linear", fill: "forwards" },
      );
      /* Portrait cover crops the wordmark. Drop the film quickly and keep
         the wash so the full lockup sits on water, not on a cropped frame. */
      fadeOut(film, portrait ? 160 : REVEAL_S * 1000);
      fadeOut(veil, portrait ? 280 : REVEAL_S * 1000);
      if (wash && !portrait) fadeOut(wash, REVEAL_S * 1000);
      fadeOut(skip, 220);
      skip.style.pointerEvents = "none";
    };

    const dock = () => {
      if (docking) return;
      docking = true;
      remember();
      skip.style.opacity = "0";
      skip.style.pointerEvents = "none";
      try { film.pause(); } catch { /* ignore */ }
      const animEls = [film, veil, flyer, skip, wash].filter((el): el is HTMLElement => !!el);
      for (const el of animEls) {
        for (const a of el.getAnimations()) a.cancel();
      }

      const from = flyerBox();
      placeFlyer(from);
      flyer.style.opacity = "1";
      film.style.opacity = "0";
      veil.style.opacity = "0";
      if (wash) wash.style.opacity = "0";

      const to = brand.getBoundingClientRect();
      if (from.width < 8 || to.height < 8) { abort(); return; }
      const s = to.height / from.height;
      const dx = (to.left + to.width / 2) - (from.left + from.width / 2);
      const dy = (to.top + to.height / 2) - (from.top + from.height / 2);

      const fly = flyer.animate(
        [
          { transform: "translate(0, 0) scale(1)", opacity: 1 },
          { transform: `translate(${dx}px, ${dy}px) scale(${s})`, opacity: 1 },
        ],
        { duration: 640, easing: "cubic-bezier(0.65, 0, 0.35, 1)", fill: "forwards" },
      );

      const settle = () => {
        root.classList.remove("is-intro");
        const fade = flyer.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 160, easing: "linear", fill: "forwards" },
        );
        const gone = stage.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 240, easing: "ease-in", fill: "forwards" },
        );
        Promise.all([fade.finished.catch(() => {}), gone.finished.catch(() => {})])
          .then(finish);
      };
      fly.finished.then(settle).catch(settle);
    };

    const abort = () => {
      flyer.style.opacity = "0";
      film.style.opacity = "0";
      veil.style.opacity = "0";
      if (wash) wash.style.opacity = "0";
      finish();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") dock();
    };
    const armedAt = performance.now() + 400;
    const onNudge = (e: Event) => {
      if (performance.now() < armedAt) return;
      if (e instanceof WheelEvent && Math.abs(e.deltaY) + Math.abs(e.deltaX) < 10) return;
      dock();
    };

    const src = film.dataset.src;
    if (!src) {
      abort();
    } else {
      stage.hidden = false;
      film.muted = true;
      film.defaultMuted = true;
      film.playsInline = true;
      film.setAttribute("playsinline", "");
      film.setAttribute("webkit-playsinline", "true");
      film.setAttribute("muted", "");
      try { film.disableRemotePlayback = true; } catch { /* ignore */ }
      film.preload = "auto";
      film.src = src;

      let playLock = false;
      const tryPlay = () => {
        if (docking || playLock) return;
        if (!film.paused && film.currentTime > 0.05) return;
        film.muted = true;
        playLock = true;
        const play = film.play();
        if (play && typeof play.finally === "function") {
          play.catch(() => {});
          play.finally(() => { playLock = false; });
        } else {
          playLock = false;
        }
      };
      film.addEventListener("loadeddata", tryPlay);
      film.addEventListener("canplay", tryPlay);
      film.addEventListener("playing", () => { /* keep live */ });
      tryPlay();
      window.setTimeout(tryPlay, 250);
      window.setTimeout(tryPlay, 900);

      film.addEventListener("timeupdate", () => {
        if (revealing || docking) return;
        if (film.duration && film.currentTime >= film.duration - REVEAL_S) {
          startReveal();
        }
      });
      film.addEventListener("ended", dock, { once: true });
      film.addEventListener("error", () => {
        if (!docking) abort();
      }, { once: true });

      const skipToDock = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        dock();
      };
      skip.addEventListener("click", skipToDock);
      /* First tap on iOS often has to unlock playback. Don't skip until
         the film is actually moving. */
      stage.addEventListener("click", (e) => {
        if (film.paused || film.currentTime < 0.08) {
          e.preventDefault();
          e.stopPropagation();
          tryPlay();
          return;
        }
        skipToDock(e);
      });
      document.addEventListener("keydown", onKey);
      window.addEventListener("wheel", onNudge, { passive: true });
      window.addEventListener("resize", onResize);

      window.setTimeout(() => {
        if (docking || !root.classList.contains("is-intro")) return;
        if (film.currentTime < 0.05) abort();
      }, 4500);
      window.setTimeout(() => {
        if (root.classList.contains("is-intro") && !docking) dock();
      }, 10000);
    }
  }
</script>
