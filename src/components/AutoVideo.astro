---
/**
 * Decorative background video.
 *
 * The src is NOT set in markup — it lives in data-src and is only promoted to
 * src by the page script when motion is allowed. That means three things fall
 * out for free:
 *
 *   JS disabled          → poster renders, nothing downloads
 *   prefers-reduced-motion → poster renders, nothing downloads
 *   normal               → video loads and plays when it scrolls into view
 *
 * Not fetching 3.7 MB for someone who asked for less motion is the honest
 * reading of the preference; merely pausing it would still spend their data.
 */
interface Props {
  src: string;
  poster: string;
  /** Below the fold the poster is withheld entirely and assigned by the same
      observer that loads the source — a `poster` attribute is fetched eagerly
      no matter where the element sits, and a CSS background is fetched as soon
      as the element paints, so neither defers anything. Until then the frame
      shows its own --deep ground. Above the fold it stays eager: it is the
      LCP candidate. */
  eagerPoster?: boolean;
  width: number;
  height: number;
  label: string;
  class?: string;
  showPause?: boolean;
  /** Swaps the pause control for a mute toggle. Only for a video whose audio
      is content rather than noise — everything else here is encoded -an. */
  sound?: boolean;
  /** Keep a visible pause next to the sound toggle. Loop clips still need a
      reachable pause; Coach keeps sound-only by leaving this unset. */
  pauseControl?: boolean;
  /** Coordinated group. The page script plays only one member at a time. */
  group?: string;
}
const {
  src,
  poster,
  width,
  height,
  label,
  class: className = "",
  showPause = true,
  sound = false,
  pauseControl = false,
  eagerPoster = false,
  group,
} = Astro.props;
const showPauseBtn = pauseControl || (showPause && !sound);
---

<div class:list={["av", className]}>
  {/* A video carrying speech is content, not decoration, so it keeps an
      accessible name and stays in the tab order. A silent background loop
      does not. */}
  <video
    class="av-el"
    data-autovideo
    data-video-group={group}
    data-src={src}
    poster={eagerPoster ? poster : undefined}
    data-poster={eagerPoster ? undefined : poster}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden={sound ? undefined : "true"}
    aria-label={sound ? label : undefined}
    tabindex={sound ? undefined : "-1"}></video>

  <div class="av-ctrls">
    {showPauseBtn ? (
      <button type="button" class="av-pause" data-av-pause aria-pressed="false" hidden>
        <span data-av-label>Пауза</span>
        <span class="sr-only">— {label}</span>
      </button>
    ) : null}
    {sound ? (
      <button type="button" class="av-pause av-sound" data-av-sound aria-pressed="false" hidden>
        <span class="av-ic" aria-hidden="true" data-av-ic>♪</span>
        <span data-av-label>Звук</span>
        <span class="sr-only">— {label}</span>
      </button>
    ) : null}
  </div>
</div>

<style>
  .av { position: relative; width: 100%; height: 100%; }

  .av-el {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .av-ctrls {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 3;
    display: flex;
    gap: 0.4rem;
    pointer-events: none;
  }

  /* A real button with a text label, not an icon glyph — every looping video
     on the page runs longer than five seconds and needs a reachable control. */
  .av-pause {
    pointer-events: auto;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    background: color-mix(in oklab, var(--abyss) 88%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in oklab, var(--foam) 22%, var(--line));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
    border-radius: var(--r);
    color: var(--foam);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .av-pause:hover { border-color: var(--caustic); }

  .av-pause[aria-pressed="true"] {
    border-color: var(--gold);
    color: var(--gold);
  }

  .av-sound { display: inline-flex; align-items: center; gap: 0.4rem; }
  .av-ic { font-size: 0.85rem; line-height: 1; }
</style>
