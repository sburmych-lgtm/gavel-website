---
/**
 * Decorative background video.
 *
 * The src is NOT set in markup — it lives in data-src and is only promoted to
 * src by the page script when motion is allowed. That means three things fall
 * out for free:
 *
 *   JS disabled          → poster renders, nothing downloads
 *   prefers-reduced-motion → poster renders, nothing downloads
 *   normal               → video loads and plays when it scrolls into view
 *
 * Not fetching 3.7 MB for someone who asked for less motion is the honest
 * reading of the preference; merely pausing it would still spend their data.
 */
interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
  class?: string;
  showPause?: boolean;
}
const {
  src,
  poster,
  width,
  height,
  label,
  class: className = "",
  showPause = true,
} = Astro.props;
---

<div class:list={["av", className]}>
  <video
    class="av-el"
    data-autovideo
    data-src={src}
    poster={poster}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"></video>

  {showPause && (
    <button type="button" class="av-pause" data-av-pause hidden>
      <span class="av-pause-txt" data-av-label>Пауза</span>
      <span class="sr-only">— {label}</span>
    </button>
  )}
</div>

<style>
  .av { position: relative; width: 100%; height: 100%; }

  .av-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* A real button with a text label, not an icon glyph — every looping video
     on the page runs longer than five seconds and needs a reachable control. */
  .av-pause {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 3;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    background: color-mix(in oklab, var(--abyss) 74%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: var(--r);
    color: var(--foam);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease);
  }
  .av-pause:hover { border-color: var(--caustic); }
</style>
