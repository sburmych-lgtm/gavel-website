---
---
<div class="backdrop" data-backdrop aria-hidden="true">
  <div class="backdrop-media" data-backdrop-media>
    <img
      src="/media/canoe-stroke-poster.webp"
      alt=""
      class="backdrop-poster"
      loading="lazy"
      decoding="async"
      width="1024"
      height="576"
    />
  </div>
  <div class="backdrop-overlay"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-backdrop, 0);
    pointer-events: none;
    overflow: hidden;
    opacity: 0.14;
    mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 1) 20%, rgba(0, 0, 0, 1) 80%, transparent 100%);
    will-change: transform;
  }

  .backdrop-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .backdrop-poster,
  :global(.backdrop-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: saturate(0.25) brightness(0.55);
  }

  .backdrop-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--abyss) 65%, transparent) 0%,
      color-mix(in oklab, var(--petrol) 65%, transparent) 100%
    );
    mix-blend-mode: multiply;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.backdrop-video) {
      display: none !important;
    }
  }
</style>
