---
import { nav, site } from "../content";
import { logo } from "../content/media";
---

<header class="hdr" data-hdr>
  <div class="shell hdr-in">
    <a class="hdr-brand" href="#top" aria-label={`${site.romanised} — на початок`}>
      <img
        src={logo.full.src}
        alt={logo.full.alt}
        width={logo.full.width}
        height={logo.full.height}
        decoding="async"
      />
    </a>

    <nav class="hdr-nav" aria-label="Основна навігація">
      <ul class="hdr-list">
        {nav.links.map((l) => (
          <li><a class="hdr-link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    {/* Ghost, not filled — the hero already owns the one gold action on
        that screen, and two filled CTAs in one viewport is the fastest way
        to make a page look generated. */}
    <a class="btn btn-ghost hdr-cta" href={nav.cta.href}>{nav.cta.label}</a>

    <button
      class="hdr-burger"
      type="button"
      data-hdr-toggle
      aria-expanded="false"
      aria-controls="hdr-panel"
    >
      <span class="sr-only">Меню</span>
      <span class="hdr-burger-b hdr-burger-b--t" aria-hidden="true"></span>
      <span class="hdr-burger-b hdr-burger-b--b" aria-hidden="true"></span>
    </button>
  </div>
</header>

{/*
  The overlay is a SIBLING of the bar, not a child of it.

  `.hdr` carries `backdrop-filter` once it turns solid, and a filtered element
  becomes the containing block for its `position: fixed` descendants. With the
  panel nested inside, `inset: <header height> 0 0 0` resolved against the
  72px-tall header instead of the viewport: measured 772px tall at the top of
  the page and 71px once scrolled, which is why the open menu showed a single
  row. Keeping it outside is the fix.
*/}
<div class="hdr-panel" id="hdr-panel" data-hdr-panel hidden>
  <nav aria-label="Мобільна навігація">
    <ul class="hdr-panel-list">
      {nav.links.map((l) => (
        <li><a class="hdr-panel-link" href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
  <a class="btn btn-primary hdr-panel-cta" href={nav.cta.href}>{nav.cta.label}</a>
  <p class="hdr-panel-foot">
    {site.city}, {site.venue}
  </p>
</div>

<style>
  /* Above the overlay, not below it: the burger is also the close control, so
     it has to stay reachable while the panel is open. */
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    /* transparent until scrolled, so the hero opens clean */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--t-base) var(--ease),
                border-color var(--t-base) var(--ease);
  }
  .hdr.is-solid {
    background: var(--glass);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line-soft);
  }
  /* While the panel is open the bar sits on an opaque overlay, so its glass
     would read as a mismatched band across the top. Drop it. */
  .hdr.is-open,
  .hdr.is-open.is-solid {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .hdr-in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  /* The complete lockup, scaled to sit inside the original bar height rather
     than the bar being grown to fit it. 52px in a 72px bar leaves 10px of
     breathing room top and bottom and nothing is cropped. */
  .hdr-brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    text-decoration: none;
  }
  .hdr-brand img { width: auto; height: 52px; }

  .hdr-nav { margin-left: auto; }

  .hdr-list {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hdr-link {
    display: inline-block;
    padding: 0.5rem 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--foam);
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast) var(--ease);
  }
  .hdr-link:hover { border-bottom-color: var(--caustic); }

  .hdr-cta { flex: none; padding: 0.625rem 1.25rem; min-height: 44px; }

  /* The bars are positioned absolutely and carry explicit modifier classes.
     They were laid out by grid and selected with :first-child / :last-child —
     but the button's first child is the screen-reader label, so only one bar
     ever rotated and the open state rendered as an arrow rather than a cross. */
  .hdr-burger {
    display: none;
    position: relative;
    margin-left: auto;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    cursor: pointer;
  }
  .hdr-burger-b {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.5px;
    margin: -0.75px 0 0 -9px;
    background: var(--foam);
    transition: transform var(--t-fast) var(--ease);
  }
  .hdr-burger-b--t { transform: translateY(-3px); }
  .hdr-burger-b--b { transform: translateY(3px); }
  .hdr-burger[aria-expanded="true"] .hdr-burger-b--t { transform: rotate(45deg); }
  .hdr-burger[aria-expanded="true"] .hdr-burger-b--b { transform: rotate(-45deg); }

  .hdr-panel {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--abyss);
    padding: 4.5rem var(--gut) calc(var(--gut) + env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .hdr-panel[hidden] { display: none; }

  .hdr-panel-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .hdr-panel-link {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 7vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--line-soft);
  }
  .hdr-panel-link:hover { color: var(--caustic); }

  .hdr-panel-cta { width: 100%; }

  .hdr-panel-foot {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  @media (max-width: 1100px) {
    .hdr-nav, .hdr-cta { display: none; }
    .hdr-burger { display: block; }
    .hdr-panel:not([hidden]) { display: block; }
  }

  @media (max-width: 560px) {
    .hdr-brand img { height: 46px; }
  }
</style>
